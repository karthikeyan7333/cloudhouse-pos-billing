# Server Configuration
PORT=3000
NODE_ENV=production

# Client URL (for CORS in production)
CLIENT_URL=https://your-domain-name.com

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cloudhouse_pos?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication Secret (Use a strong, 64-character random string)
JWT_SECRET=your_production_secure_jwt_secret_key_change_me_before_deploying

# Default Seed Credentials (created safely on first run if database is empty)
ADMIN_NAME=CloudHouse Store Manager
ADMIN_EMAIL=admin@cloudhousepos.com
ADMIN_PASSWORD=your_secure_admin_password_here

STAFF_NAME=Store Cashier
STAFF_EMAIL=staff@cloudhousepos.com
STAFF_PASSWORD=your_secure_staff_password_here

# Frontend API URL
VITE_API_URL=/api
